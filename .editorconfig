# =============================================================================
# EditorConfig —— 统一编辑器的基础格式约定
# https://editorconfig.org
# =============================================================================
# 与 `.gitattributes` 的分工：
#   * `.gitattributes` 管**入库时的换行**（跨平台一致性，强制生效）；
#   * `.editorconfig`  管**编辑时的风格**（缩进 / 编码 / 尾空格，编辑器遵循）。
# 两者对换行的结论**必须一致**，尤其是下面的 `*.bat` 例外。
# =============================================================================

root = true

# -----------------------------------------------------------------------------
# 默认（适用于未单独列出的所有文件）
# -----------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# -----------------------------------------------------------------------------
# 分语言缩进
# -----------------------------------------------------------------------------
# Python 后端统一 4 空格（PEP 8）
[*.py]
indent_size = 4

# Markdown：允许**行尾双空格**（表示软换行），不要自动去掉
[*.md]
trim_trailing_whitespace = false

# 依赖与配置清单：保持 2 空格（npm / pip 生态默认）
[{package.json,package-lock.json,*.json,*.yml,*.yaml,*.toml}]
indent_size = 2

# -----------------------------------------------------------------------------
# ⚠️ 例外：Windows 批处理**必须** CRLF（本项目踩过的坑）
# -----------------------------------------------------------------------------
# 实证：`启动题库.bat` 用 LF 换行时，cmd 解析多行括号块会失败，脚本一闪即退。
# `.gitattributes` 已强制 `*.bat text eol=crlf`；这里再对齐编辑器默认，
# 避免本地新建的 `.bat` 被编辑器写成 LF。
[*.{bat,cmd}]
end_of_line = crlf
indent_size = 2
