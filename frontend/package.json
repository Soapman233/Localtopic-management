    "@tanstack/react-query": "^5.51.0",
    "katex": "^0.16.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.21.5",
